{
  "name": "Demo 01 - Core Data Pipeline",
  "namespace": "demo",
  "description": "Variables, JavaScript, Python, comments, ordered edges, structured inputs, and structured outputs.",
  "nodes": [
    {
      "id": "node-multiplier",
      "type": "custom",
      "position": { "x": 80, "y": 80 },
      "data": {
        "label": "multiplier",
        "type": "variable",
        "value": "3"
      },
      "draggable": true
    },
    {
      "id": "node-start",
      "type": "custom",
      "position": { "x": 80, "y": 340 },
      "data": {
        "label": "Create sample dataset",
        "type": "javascript",
        "language": "javascript",
        "code": "const values = [3, 7, 11, 15];\nconsole.log('source values', values);\nreturn { values, generatedAt: new Date().toISOString() };",
        "isStarterNode": true
      },
      "draggable": true
    },
    {
      "id": "node-python-stats",
      "type": "custom",
      "position": { "x": 520, "y": 340 },
      "data": {
        "label": "Calculate statistics",
        "type": "python",
        "language": "python",
        "code": "values = input['values']\nscaled = [value * multiplier for value in values]\noutput = {\n    'original': values,\n    'scaled': scaled,\n    'count': len(values),\n    'sum': sum(scaled),\n    'average': sum(scaled) / len(scaled)\n}\nprint('calculated', output)"
      },
      "draggable": true
    },
    {
      "id": "node-format",
      "type": "custom",
      "position": { "x": 980, "y": 340 },
      "data": {
        "label": "Build final report",
        "type": "javascript",
        "language": "javascript",
        "code": "return {\n  status: 'success',\n  summary: `${input.count} values, average ${input.average}`,\n  statistics: input\n};"
      },
      "draggable": true
    },
    {
      "id": "node-comment",
      "type": "comment",
      "position": { "x": 500, "y": 80 },
      "data": {
        "label": "What this demonstrates",
        "type": "comment",
        "value": "The multiplier variable is globally injected into the Python node even though the variable node is not connected. Data itself follows the directed edges."
      },
      "draggable": true
    }
  ],
  "edges": [
    { "id": "edge-start-stats", "source": "node-start", "target": "node-python-stats", "type": "smoothstep", "animated": true },
    { "id": "edge-stats-format", "source": "node-python-stats", "target": "node-format", "type": "smoothstep", "animated": true }
  ],
