{
  "name": "Demo 04 - Nested Subflow",
  "namespace": "demo",
  "description": "An embedded reusable subflow with its own entry point, JavaScript and Python nodes, scoped execution, and parent-child data passing.",
  "nodes": [
    {
      "id": "node-parent-start",
      "type": "custom",
      "position": { "x": 80, "y": 300 },
      "data": {
        "label": "Parent input",
        "type": "javascript",
        "language": "javascript",
        "code": "return { values: [2, 4, 6], source: 'parent-flow' };",
        "isStarterNode": true
      },
      "draggable": true
    },
    {
      "id": "node-subflow",
      "type": "custom",
      "position": { "x": 520, "y": 300 },
      "data": {
        "label": "Reusable statistics subflow",
        "type": "flow",
        "code": "{\"nodes\":[{\"id\":\"node-inner-start\",\"type\":\"custom\",\"position\":{\"x\":80,\"y\":200},\"data\":{\"label\":\"Normalize inner input\",\"type\":\"javascript\",\"language\":\"javascript\",\"code\":\"return { ...input, enteredSubflow: true };\",\"isStarterNode\":true},\"draggable\":true},{\"id\":\"node-inner-python\",\"type\":\"custom\",\"position\":{\"x\":500,\"y\":200},\"data\":{\"label\":\"Inner Python statistics\",\"type\":\"python\",\"language\":\"python\",\"code\":\"values = input['values']\\noutput = {**input, 'sum': sum(values), 'count': len(values), 'scope': 'nested'}\"},\"draggable\":true}],\"edges\":[{\"id\":\"edge-inner\",\"source\":\"node-inner-start\",\"target\":\"node-inner-python\",\"type\":\"smoothstep\"}]}",
        "isRelativePath": false
      },
      "draggable": true
    },
    {
      "id": "node-parent-finish",
      "type": "custom",
      "position": { "x": 980, "y": 300 },
      "data": {
        "label": "Parent receives subflow output",
        "type": "javascript",
        "language": "javascript",
        "code": "return { status: 'nested-flow-complete', result: input };"
      },
      "draggable": true
    },
    {
      "id": "node-comment",
      "type": "comment",
      "position": { "x": 500, "y": 40 },
      "data": {
        "label": "Nested execution",
        "type": "comment",
        "value": "Double-click the green flow node to inspect its embedded graph. Execution logs preserve parent scope so repeated nested node IDs remain distinguishable."
      },
      "draggable": true
    }
  ],
  "edges": [
    { "id": "edge-parent-subflow", "source": "node-parent-start", "target": "node-subflow", "type": "smoothstep", "animated": true },
    { "id": "edge-subflow-finish", "source": "node-subflow", "target": "node-parent-finish", "type": "smoothstep", "animated": true }
  ],
  "artifacts": []
}
