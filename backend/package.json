{
    "name": "orchestrator-backend",
    "version": "1.0.0",
    "description": "Orchestrator API Server - REST API for job execution and session management",
    "main": "api-server.cjs",
    "bin": "api-server.cjs",
    "type": "module",
    "scripts": {
        "start": "node api-server.cjs",
        "build": "pkg . --targets node18-win-x64 --output dist/orchestrator-backend.exe && node scripts/patch-exe.mjs",
        "build:linux": "pkg . --targets node18-linux-x64 --output dist/orchestrator-backend-linux",
        "build:mac": "pkg . --targets node18-macos-x64 --output dist/orchestrator-backend-mac",
        "build:all": "pkg . --targets node18-win-x64 --output dist/orchestrator-backend.exe && node scripts/patch-exe.mjs && pkg . --targets node18-linux-x64 --output dist/orchestrator-backend-linux && pkg . --targets node18-macos-x64 --output dist/orchestrator-backend-mac"
    },
    "pkg": {
        "scripts": "api-server.cjs",
        "assets": [
            "groovyExec.jar"
        ],
        "outputPath": "dist"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dayjs": "^1.11.13",
        "express": "^5.1.0",
        "lodash": "^4.17.21",
        "playwright": "^1.43.1",
        "tree-kill": "^1.2.2"
    },
    "devDependencies": {
        "pkg": "^5.8.1",
        "resedit": "^3.0.2"
    },
    "engines": {
        "node": ">=18"
    }
}
