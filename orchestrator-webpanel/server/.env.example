# MongoDB connection (comment out to use NeDB embedded)
MONGO_URI=mongodb://host:27017/orchestrator

# Server
PORT=3939
NODE_ENV=development

# Default admin password on first startup (change immediately)
ADMIN_PASSWORD=admin

# Base directory for inbox/outbox temp files
ORCHESTRATOR_WORK_DIR=C:\workspace\OrchestratorServer

# Shared secret workers must send on registration
WORKER_REGISTRATION_SECRET=change_me_in_production

# AES encryption key for secrets at rest (auto-generated if omitted)
# SECRET_ENCRYPTION_KEY=
