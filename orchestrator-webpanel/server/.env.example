# ──────────────────────────────────────────────────────────────────────────
#  Orchestrator server — environment variables
#  Copy to `.env` and adjust. Every variable below is optional unless noted;
#  the value shown is the default used when the variable is absent.
# ──────────────────────────────────────────────────────────────────────────

# ── HTTP server ────────────────────────────────────────────────────────────
# Port the API / web panel listens on.
PORT=3939
# Public base URL (scheme + host, NO port) used to build outbound URLs
# (e.g. the CAS `service=` parameter in proxy/SSO validation).
# Default: http://localhost
DOMAIN=http://localhost
# 'development' | 'production' — only affects logging/labels.
NODE_ENV=development

# ── HTTPS / TLS ────────────────────────────────────────────────────────────
# Set HTTPS=true to listen on TLS instead of plain HTTP.
# HTTPS=true
# Paths to the certificate / key (PEM). When HTTPS=true and these are unset,
# the server looks for <ORCHESTRATOR_WORK_DIR>/certs/server.crt + server.key.
# Use the bundled script `scripts/gen-cert.bat` to generate a self-signed pair.
# HTTPS_CERT=C:\workspace\OrchestratorServer\certs\server.crt
# HTTPS_KEY=C:\workspace\OrchestratorServer\certs\server.key

# ── Database ───────────────────────────────────────────────────────────────
# MongoDB connection string. Comment this out entirely to fall back to the
# embedded NeDB store at <ORCHESTRATOR_WORK_DIR>/data.
MONGO_URI=mongodb://host:27017/orchestrator

# ── Auth & secrets ─────────────────────────────────────────────────────────
# Password for the built-in `admin` account, applied on first startup.
# Change it immediately after first login.
ADMIN_PASSWORD=admin
# Secret used to sign JWT session tokens. MUST be a long random value in
# production (default is a well-known placeholder).
JWT_SECRET=change_me_in_production
# AES key used to encrypt stored secrets at rest. Set a stable random value;
# changing it later makes existing encrypted secrets unreadable.
ORCHESTRATOR_MASTER_KEY=change_me_in_production
# Shared secret workers must present on /workers/register. Leave empty to allow
# any worker to register.
WORKER_REGISTRATION_SECRET=change_me_in_production

# ── Filesystem ─────────────────────────────────────────────────────────────
# Base directory for inbox/outbox temp files, the NeDB `data/` folder and the
# bundled groovyExec.jar. Defaults to the process working directory.
ORCHESTRATOR_WORK_DIR=C:\workspace\OrchestratorServer
# Working directory (cwd) for spawned processes during node execution.
# Defaults to ORCHESTRATOR_WORK_DIR when absent.
# ORCHESTRATOR_EXECUTION_DIR=C:\workspace\OrchestratorServer\executions
# When 'true', artifact files extracted before execution are kept afterwards.
# Default is false (artifacts are deleted after each run).
# ORCHESTRATOR_KEEP_ARTIFACTS=false

# ── Local node execution (in-process executor) ─────────────────────────────
# Master switch for server-side node execution. When 'false', the server refuses
# to run any leaf node locally — every script/JS node must be bound to a worker.
# Orchestration (flow nodes, nested-flow traversal) still runs in-process.
# Default: true.
# ORCHESTRATOR_SERVER_EXECUTION_ENABLED=true
# Poll interval (ms) for draining child-process output.
POLL_INTERVAL_MS=200
# Interval (ms) between stop-requested checks while a job runs.
STOP_CHECK_INTERVAL_MS=500
# Hard timeout (ms) for a JS backend node. 0 = no timeout.
JS_BACKEND_TIMEOUT_MS=0
# Default timeout (ms) applied to a flow run that declares none. 0 = no timeout.
DEFAULT_FLOW_TIMEOUT_MS=0
# Explicit path to the Node.js executable used to run JS nodes. Auto-detected
# when omitted.
# NODE_EXECUTABLE_PATH=C:\Program Files\nodejs\node.exe
# Explicit path to groovyExec.jar (for Groovy nodes). Defaults to
# <ORCHESTRATOR_WORK_DIR>/groovyExec.jar.
# GROOVY_JAR=C:\path\to\groovyExec.jar

# ── Proxy / SSO authentication ─────────────────────────────────────────────
# When set, enables SSO ticket-based login. The frontend auto-detects the
# ticket in the URL and exchanges it transparently.
#
# Query-param name that carries the SSO ticket (default: ticket).
# ORCHESTRATOR_PROXYAUTH_NAME=ticket
# Base URL of the CAS/SSO validation endpoint.
# The server calls: <URL>?<PARAM_NAME>=<ticket>&service=<DOMAIN>:<PORT>
# ORCHESTRATOR_PROXYAUTH_URL=https://sso.example.com/validate
# Regular expression applied to the validation response body.
# Capture group 1 must contain the login name.
# Example for CAS XML:  <cas:user>([^<]+)</cas:user>
# ORCHESTRATOR_PROXYAUTH_REGEX=<cas:user>([^<]+)</cas:user>
