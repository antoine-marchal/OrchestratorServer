# ──────────────────────────────────────────────────────────────────────────
#  Orchestrator Webpanel — systemd environment file (RPM deployment)
#  Loaded by systemd (EnvironmentFile). One KEY=value per line, no quotes.
#  Derived from server/.env.example, tuned for the /opt + /var/lib layout.
#  Full variable reference: orchestrator-webpanel/server/.env.example
# ──────────────────────────────────────────────────────────────────────────

# ── HTTP server ────────────────────────────────────────────────────────────
PORT=3939
NODE_ENV=production
# Public base URL (scheme + host, NO port). Used for outbound URLs + CORS.
# DOMAIN=https://orchestrator.example.com
# Extra allowed CORS origins, comma-separated (in addition to DOMAIN).
# ORCHESTRATOR_CORS_ORIGINS=https://orchestrator.example.com
# JSON_BODY_LIMIT=100mb
# ARTIFACT_UPLOAD_LIMIT=1024mb

# ── HTTPS / TLS ────────────────────────────────────────────────────────────
# In production a reverse proxy (Nginx/Apache) terminating TLS is usually
# preferable; leave this off and proxy to http://127.0.0.1:3939.
# HTTPS=true
# HTTPS_CERT=/var/lib/orchestrator-webpanel/certs/server.crt
# HTTPS_KEY=/var/lib/orchestrator-webpanel/certs/server.key

# ── Database ───────────────────────────────────────────────────────────────
# MongoDB connection string. Comment out to use the embedded NeDB store at
# <ORCHESTRATOR_WORK_DIR>/data.
# MONGO_URI=mongodb://localhost:27017/orchestrator

# ── Auth & secrets (REQUIRED in production) ─────────────────────────────────
# Server refuses to start (exit 1) if any is left at its placeholder.
# Generate each with:  openssl rand -hex 32
# Built-in admin password — default 'admin' is rejected in production.
ADMIN_PASSWORD=change_me_in_production
JWT_SECRET=change_me_in_production
ORCHESTRATOR_MASTER_KEY=change_me_in_production
# Shared secret workers present on /workers/register. Empty = allow any worker.
WORKER_REGISTRATION_SECRET=change_me_in_production

# ── Filesystem ─────────────────────────────────────────────────────────────
# Base dir for inbox/outbox, NeDB data/, and the extracted groovyExec.jar.
# Must match WorkingDirectory + ReadWritePaths in the unit file.
ORCHESTRATOR_WORK_DIR=/var/lib/orchestrator-webpanel
# ORCHESTRATOR_EXECUTION_DIR=/var/lib/orchestrator-webpanel/executions
# ORCHESTRATOR_KEEP_ARTIFACTS=false

# ── Local node execution ────────────────────────────────────────────────────
# ORCHESTRATOR_SERVER_EXECUTION_ENABLED=true
# ORCHESTRATOR_FAIL_ON_LOG_ERROR=false
# SERVER_EXECUTION_MODE=parallel
# Path to a JRE for Groovy nodes is auto-detected; groovyExec.jar defaults to
# <ORCHESTRATOR_WORK_DIR>/groovyExec.jar (extracted from the binary on boot).
# NODE_EXECUTABLE_PATH=/usr/bin/node

# ── Proxy / SSO authentication (optional) ───────────────────────────────────
# ORCHESTRATOR_PROXYAUTH_TLS_REJECT_UNAUTHORIZED=false
# ORCHESTRATOR_PROXYAUTH_URL=https://sso.example.com/validate
# ORCHESTRATOR_PROXYAUTH_LOGIN_URL=https://sso.example.com/login
# ORCHESTRATOR_PROXYAUTH_REGEX=<cas:user>([^<]+)</cas:user>
# ORCHESTRATOR_PROXYAUTH_TIMEOUT_MS=5000