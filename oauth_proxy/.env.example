# oauth_proxy — OAuth2 bridge to the CAS authent_test_service
# Copy to `.env` and adjust.

# Port this proxy listens on.
PORT=9000

# Public base URL of this proxy (browser + Grafana must reach it). No trailing slash.
PUBLIC_URL=http://localhost:9000

# Base URL of the CAS-style authent_test_service (its /login and /validate).
CAS_BASE=http://localhost:8443

# OAuth client credentials Grafana presents. CLIENT_SECRET empty = not enforced.
CLIENT_ID=some_id
CLIENT_SECRET=

# Domain used to synthesize an email from the CAS login (scope user:email).
EMAIL_DOMAIN=example.com

# Lifetimes (ms): authorization code (short) and access token.
CODE_TTL_MS=120000
TOKEN_TTL_MS=3600000
