# ──────────────────────────────────────────────────────────────────────────
#  Orchestrator worker — environment variables
#  Copy to `.env` and adjust. Every variable below is optional unless noted;
#  the value shown is the default used when the variable is absent.
# ──────────────────────────────────────────────────────────────────────────

# Orchestrator server this worker connects to (just scheme://host:port — the
# /api/v1/... paths are appended automatically).
ORCHESTRATOR_URL=http://localhost:3939

# Display name in the UI. Defaults to "worker-<random8>".
WORKER_NAME=my-worker

# Must match WORKER_REGISTRATION_SECRET on the server (if the server sets one).
WORKER_REGISTRATION_SECRET=change_me_in_production

# How often (ms) the worker polls the server for pending jobs.
POLL_INTERVAL_MS=2000

# Max size of an HTTP request / response the worker will exchange with the server.
# Accepts string size like 50mb / 1gb (or raw bytes). Flow artifacts (base64)
# inflate the response when picking up jobs — bump this if a large artifact
# fails to download. Must be >= server JSON_BODY_LIMIT. Default: 100mb.
# WORKER_MAX_HTTP_SIZE=100mb

# How often (ms) the worker sends a heartbeat — keeps its status "online".
HEARTBEAT_INTERVAL_MS=10000

# Job pickup strategy:
#   parallel   (default) — take jobs as they arrive, even while a node from
#              another flow is still running on this worker.
#   sequential — finish every in-flight job from the flow the worker is
#              currently bound to before accepting a job from a different flow.
#              Other flows' jobs stay queued on the server until the worker is
#              idle, then it binds to whichever flow's job arrives next.
WORKER_EXECUTION_MODE=parallel

# Directory for temp script files (inbox/) and the extracted groovyExec.jar.
# Defaults to the process working directory.
ORCHESTRATOR_WORK_DIR=C:\workspace\OrchestratorServer

# Working directory (cwd) for spawned processes during node execution.
# Defaults to ORCHESTRATOR_WORK_DIR when absent.
# ORCHESTRATOR_EXECUTION_DIR=C:\workspace\OrchestratorServer\executions

# When 'true', artifact files extracted before execution are kept afterwards.
# Default is false (artifacts are deleted after each run).
# ORCHESTRATOR_KEEP_ARTIFACTS=false

# Artifacts are downloaded + decompressed once per flow execution and shared by
# every node of that flow. This is the grace window (ms) after a flow's last
# node finishes before its artifacts are swept from disk. Default: 30000.
# ORCHESTRATOR_ARTIFACT_CLEANUP_DELAY_MS=30000

# Group name for this worker. Used to visually group workers in the UI.
# Leave empty (default) to show the worker without a group.
# WORKER_GROUP=production

# Explicit path to groovyExec.jar (defaults to
# <ORCHESTRATOR_WORK_DIR>/groovyExec.jar).
# GROOVY_JAR=C:\path\to\groovyExec.jar

# When 'true', a node whose stdout/stderr contains the tokens ERROR or FAILED
# (word-boundary, case-sensitive) is forced to FAILED even when the process
# exits 0. Must match the server's ORCHESTRATOR_FAIL_ON_LOG_ERROR. Default: false
# (a node only fails on a non-zero exit code).
# ORCHESTRATOR_FAIL_ON_LOG_ERROR=false
