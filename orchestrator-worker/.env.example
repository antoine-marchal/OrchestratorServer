# Orchestrator server to connect to
ORCHESTRATOR_URL=http://localhost:3939

# Display name in the UI
WORKER_NAME=my-worker

# Must match WORKER_REGISTRATION_SECRET on the server
WORKER_REGISTRATION_SECRET=change_me_in_production

# Polling interval (ms)
POLL_INTERVAL_MS=2000

# Heartbeat interval (ms) — keeps worker status as "online"
HEARTBEAT_INTERVAL_MS=10000

# Directory for temp script files (inbox/)
ORCHESTRATOR_WORK_DIR=C:\workspace\OrchestratorServer

# Path to groovyExec.jar (defaults to ORCHESTRATOR_WORK_DIR/groovyExec.jar)
# GROOVY_JAR=C:\path\to\groovyExec.jar
