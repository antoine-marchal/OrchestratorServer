# ──────────────────────────────────────────────────────────────────────────
#  Orchestrator worker — environment variables
#  Copy to `.env` and adjust. Every variable below is optional unless noted;
#  the value shown is the default used when the variable is absent.
# ──────────────────────────────────────────────────────────────────────────

# Orchestrator server this worker connects to (just scheme://host:port — the
# /api/v1/... paths are appended automatically).
ORCHESTRATOR_URL=http://localhost:3939

# Display name in the UI. Defaults to "worker-<random8>".
WORKER_NAME=my-worker

# Must match WORKER_REGISTRATION_SECRET on the server (if the server sets one).
WORKER_REGISTRATION_SECRET=change_me_in_production

# How often (ms) the worker polls the server for pending jobs.
POLL_INTERVAL_MS=2000

# How often (ms) the worker sends a heartbeat — keeps its status "online".
HEARTBEAT_INTERVAL_MS=10000

# Job pickup strategy:
#   parallel   (default) — take jobs as they arrive, even while a node from
#              another flow is still running on this worker.
#   sequential — finish every in-flight job from the flow the worker is
#              currently bound to before accepting a job from a different flow.
#              Other flows' jobs stay queued on the server until the worker is
#              idle, then it binds to whichever flow's job arrives next.
WORKER_EXECUTION_MODE=parallel

# Directory for temp script files (inbox/) and the extracted groovyExec.jar.
# Defaults to the process working directory.
ORCHESTRATOR_WORK_DIR=C:\workspace\OrchestratorServer

# Explicit path to groovyExec.jar (defaults to
# <ORCHESTRATOR_WORK_DIR>/groovyExec.jar).
# GROOVY_JAR=C:\path\to\groovyExec.jar
