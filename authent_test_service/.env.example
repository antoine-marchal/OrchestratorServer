# authent_test_service — CAS/SSO simulation env
# Copy to `.env` and adjust.

# Port this mock CAS server listens on.
PORT=8443

# Login returned on every successful /validate (the simulated SSO identity).
# Must match an existing Orchestrator user login for proxy-auth to succeed.
DEFAULT_USER=marchala

# Max ticket lifetime in ms before it's rejected (CAS default ~5 min).
TICKET_TTL_MS=300000
